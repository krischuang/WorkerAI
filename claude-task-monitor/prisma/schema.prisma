generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  active
  paused
  archived
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum TaskStatus {
  pending
  queued
  running
  paused
  completed
  failed
  archived
  needs_review
}

enum CostLevel {
  low
  medium
  high
}

enum TaskType {
  coding
  research
  writing
  review
  maintenance
}

enum ReviewStatus {
  pending
  running
  done
  incomplete
  skipped
  failed
}

enum WorkspaceStrategy {
  local_permanent
  temporary_clone
  remote_api
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  priority    Priority      @default(P3)
  status      ProjectStatus @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tasks           Task[]
  scheduledTasks  ScheduledTask[]

  // Auto-review: queue completed tasks for Claude quality review
  autoReviewEnabled     Boolean   @default(false)

  // Project improvement scanner
  autoScanEnabled       Boolean   @default(false)
  scanFrequencyDays     Int       @default(7)
  lastScannedAt         DateTime?
  scans                 ProjectScan[]
  debtItems             DebtItem[]
  suggestions           TaskSuggestion[]

  // Continuous improvement engine
  improvementAutomationLevel  Int       @default(0)
  cycleFrequencyDays          Int       @default(7)
  lastImprovementCycleAt      DateTime?
  nextImprovementCycleAt      DateTime?
  improvementCycles           ImprovementCycle[]

  // Scan failure circuit-breaker: pause auto-improvement after 3 consecutive scan failures
  scanFailureCount      Int       @default(0)
  autoImprovementPaused Boolean   @default(false)

  // Remote-first repository support
  repoUrl               String?
  defaultBranch         String    @default("main")
  workspaceStrategy     WorkspaceStrategy @default(local_permanent)

  // Progress tracking — updated after every task status change
  completionPct         Float?
  totalTasks            Int?
  completedTasks        Int?
  failedTasks           Int?
  runningTasks          Int?
  pendingTasks          Int?
  progressUpdatedAt     DateTime?
  estimatedCompletionAt DateTime?
}

model Task {
  id                 String         @id @default(cuid())
  projectId          String
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serverId           String?
  server             Server?        @relation(fields: [serverId], references: [id], onDelete: SetNull)
  agentId            String?
  agent              Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  priority           Priority       @default(P3)
  status             TaskStatus     @default(pending)
  estimatedCostLevel CostLevel      @default(medium)
  taskType           TaskType       @default(coding)
  resultSummary      String?
  nextAction         String?
  runId              String?
  completionNonce    String?
  tmuxOutputOffset   Int?
  // Per-task tmux session name (claude_<taskId>) used for parallel execution on servers.
  // Null for agent tasks (agents use their own session) and legacy tasks dispatched
  // before per-task sessions were introduced.
  taskTmuxSession    String?
  // Hard wall-clock timeout in minutes. Resolution: task → server/agent default → 120 min global.
  timeoutMinutes     Int?
  // Zombie / stall detection
  lastProgressAt     DateTime?
  stallDetectedAt    DateTime?
  // Scheduled dispatch — pending task auto-queues when scheduledFor <= now()
  scheduledFor       DateTime?
  // Retry engine
  retryCount         Int            @default(0)
  maxRetries         Int            @default(0)
  retryAfter         DateTime?
  lastFailReason     String?
  // Dependency tracking — number of incomplete prerequisites; 0 means ready to run
  blockedByCount     Int            @default(0)
  // Opt out of tmux pane capture for tasks that process sensitive workloads
  disablePaneCapture Boolean        @default(false)
  // Incremental progress reported by the agent during execution (0-100 %)
  progressPercent    Int?
  progressMessage    String?
  // Temporary workspace directory path (set during execution, cleared on completion/failure)
  workspaceDir       String?
  // Auto-review fields — populated when project.autoReviewEnabled is true
  autoReviewEnabled  Boolean        @default(false)
  reviewStatus       ReviewStatus?
  reviewScheduledAt  DateTime?
  reviewStartedAt    DateTime?
  reviewCompletedAt  DateTime?
  reviewVerdictNotes String?
  reviewAttempts     Int            @default(0)
  // Tags required on the assigned agent for this task to be dispatched.
  requiredTags       String[]
  // Stale-pending alert deduplication — set when the alert fires so it doesn't repeat < 1 h
  lastStalePendingAlertAt DateTime?
  // Link back to the ScheduledTask that spawned this task (null for manually created tasks)
  scheduledTaskId    String?
  scheduledTask      ScheduledTask? @relation(fields: [scheduledTaskId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  executionLogs      ExecutionLog[]
  dependents         TaskDependency[] @relation("DependentTask")
  prerequisites      TaskDependency[] @relation("PrerequisiteTask")
  secrets            TaskSecret[]
  artifacts          TaskArtifact[]

  @@index([status])
  @@index([priority])
  @@index([projectId])
  @@index([serverId])
  @@index([reviewStatus])
  @@index([scheduledFor])
}

model TaskSecret {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  key            String
  encryptedValue String
  createdAt      DateTime @default(now())

  @@unique([taskId, key])
  @@index([taskId])
}

model TaskArtifact {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  filename    String
  sizeBytes   Int
  mimeType    String   @default("application/octet-stream")
  storagePath String
  createdAt   DateTime @default(now())

  @@index([taskId])
}

model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task     @relation("PrerequisiteTask", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
}

model ExecutionLog {
  id            String     @id @default(cuid())
  taskId        String
  task          Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  status        TaskStatus
  logText       String?
  errorMessage  String?
  outputSummary String?
  retryNumber   Int        @default(0)
  failureReason String?
  // Enriched completion metadata
  durationMs    Int?
  exitReason    String?
  paneCapture   String?
  runId         String?    // same runId as Task.runId at dispatch time, for done-file correlation
  archivedAt    DateTime?
  // Cost tracking
  usageSnapshotPct Float?  // claudeSessionPct at dispatch time (before), for delta calculation
  tokenCount    Int?       // total tokens used (input + output) for this execution
  actualCostUsd Float?     // estimated USD cost based on token count and model pricing
  // Full-text search vector (tsvector — managed by DB trigger)
  searchVector  Unsupported("tsvector")?
  createdAt     DateTime   @default(now())

  @@index([taskId])
  @@index([archivedAt])
  @@index([finishedAt])
}

enum ServerStatus {
  unknown
  connected
  failed
}

enum CommandStatus {
  success
  failed
}

enum ClaudePermissionMode {
  read_only
  workspace_write
  full_autonomous
}

enum AgentStatus {
  idle
  running
  offline
  error
}

model Agent {
  id          String      @id @default(cuid())
  serverId    String
  server      Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  workDir     String
  tmuxSession String

  status               AgentStatus          @default(offline)
  claudePermissionMode ClaudePermissionMode @default(workspace_write)

  // Default timeout (minutes) for tasks running on this agent. Overridden per-task.
  defaultTaskTimeoutMinutes Int?

  // Max tasks this agent can run concurrently (each in its own per-task tmux session).
  maxConcurrentTasks Int @default(1)

  // Capability tags describing what this agent can do (e.g. "has-browser", "gpu", "nodejs-available").
  tags String[]

  // Health monitoring
  healthScore          Int?
  consecutiveFailures  Int       @default(0)
  lastHealthCheckAt    DateTime?

  // Disk usage — updated each health check via df -k <workDir>
  diskUsedBytes        BigInt?
  diskTotalBytes       BigInt?

  // Auto-recovery
  autoRecovery         Boolean   @default(false)
  recoveryAttempts     Int       @default(0)
  maxRecoveryAttempts  Int       @default(3)
  lastRecoveryAt       DateTime?

  claudeSessionPct      Float?
  claudeSessionResets   String?
  claudeSessionResetsAt DateTime?
  claudeWeekPct         Float?
  claudeWeekResets      String?
  claudeWeekResetsAt    DateTime?
  claudeUsageRaw        String?
  claudeUsageFetchedAt  DateTime?

  // Usage credits and last refresh outcome (set by pipe-pane usage refresh)
  claudeUsageCreditsEnabled Boolean?
  claudeLastRefreshStatus   String?   // "ok" | "rate_limited" | "error" | "offline" | "auth_required"

  // Auto-pause on usage limit
  autoPauseEnabled  Boolean   @default(true)
  pausedDueToUsage  Boolean   @default(false)
  pausedAt          DateTime?

  // Cooldown after any terminal task status — poller skips dispatch until this passes
  cooldownUntil DateTime?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  tasks          Task[]
  workerHealths  WorkerHealth[]
  recoveryLogs   RecoveryLog[]
  usageSnapshots AgentUsageSnapshot[]

  @@unique([serverId, slug])
}

// Point-in-time snapshot from a pipe-pane usage capture.
// Stored on every refresh attempt (success or failure) to preserve history.
// Never interpret null usagePercent as 0% — null means parsing failed.
model AgentUsageSnapshot {
  id                  String    @id @default(cuid())
  agentId             String
  agent               Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Parsed fields — null means the field was not present in the captured output.
  usagePercent        Float?    // current week %
  resetTime           String?   // display string e.g. "Jun 15, 9am (Sydney)"
  resetAt             DateTime? // parsed UTC DateTime for countdown math
  usageCreditsEnabled Boolean?  // null = unknown; false = "credits are off"

  // Capture metadata
  captureStatus String   @default("unknown") // "ok" | "rate_limited" | "error" | "offline" | "auth_required"
  capturedAt    DateTime @default(now())

  // Truncated raw / cleaned output (2000-char limit each)
  rawOutput     String?
  cleanedOutput String?

  @@index([agentId, capturedAt])
}

model Server {
  id            String        @id @default(cuid())
  name          String
  host          String
  username      String
  port          Int           @default(22)
  sshKeyPath    String
  status        ServerStatus  @default(unknown)
  lastCheckedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  commandLogs   ServerCommandLog[]
  tasks         Task[]
  agents        Agent[]

  // tmux session name where Claude CLI runs on this server (for server-direct tasks)
  tmuxSession   String        @default("claude")

  // Claude execution mode — controls which flags are passed when launching Claude CLI
  claudePermissionMode  ClaudePermissionMode @default(workspace_write)

  // Default timeout (minutes) for tasks running on this server. Overridden per-task.
  defaultTaskTimeoutMinutes Int?

  // Health monitoring
  healthScore          Int?
  consecutiveFailures  Int       @default(0)
  lastHealthCheckAt    DateTime?

  // Disk usage — updated each health check via df -k on the server root filesystem
  diskUsedBytes        BigInt?
  diskTotalBytes       BigInt?

  // Auto-recovery
  autoRecovery         Boolean   @default(false)
  recoveryAttempts     Int       @default(0)
  maxRecoveryAttempts  Int       @default(3)
  lastRecoveryAt       DateTime?

  // Claude usage — persisted from last successful tmux capture
  claudeSessionPct      Float?
  claudeSessionResets   String?    // Sydney timezone e.g. "Jun 10, 1:10 am (Sydney)"
  claudeSessionResetsAt DateTime?  // UTC datetime of session reset (for countdown)
  claudeWeekPct         Float?
  claudeWeekResets      String?    // Sydney timezone
  claudeWeekResetsAt    DateTime?  // UTC datetime of week reset (for countdown)
  claudeUsageRaw        String?    // raw tmux pane text
  claudeUsageFetchedAt  DateTime?

  // Auto-pause on usage limit
  autoPauseEnabled  Boolean   @default(true)
  pausedDueToUsage  Boolean   @default(false)
  pausedAt          DateTime?

  // Capacity scoring — updated each poller cycle
  capacityScore        Float?
  activeTaskCount      Int       @default(0)
  maxConcurrentTasks   Int       @default(10)
  capacityUpdatedAt    DateTime?

  workerHealths WorkerHealth[]
  recoveryLogs  RecoveryLog[]
}

model ServerCommandLog {
  id           String        @id @default(cuid())
  serverId     String
  server       Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  command      String
  status       CommandStatus
  output       String?
  errorMessage String?
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  createdAt    DateTime      @default(now())
}

// Health check record written each cycle per worker.
model WorkerHealth {
  id           String    @id @default(cuid())
  serverId     String?
  server       Server?   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  agentId      String?
  agent        Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  healthScore  Int
  sshOk        Boolean
  tmuxOk       Boolean
  claudeOk     Boolean
  latencyMs    Int?
  errorMessage String?
  checkedAt    DateTime  @default(now())

  @@index([serverId, checkedAt])
  @@index([agentId, checkedAt])
}

// Recovery attempt record written on every manual or auto-recovery call.
model RecoveryLog {
  id           String    @id @default(cuid())
  serverId     String?
  server       Server?   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  agentId      String?
  agent        Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  triggeredBy  String    @default("auto")   // "auto" | "manual"
  success      Boolean
  command      String?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([serverId, createdAt])
  @@index([agentId, createdAt])
}

model TaskTemplate {
  id                  String    @id @default(cuid())
  name                String
  category            String
  taskType            TaskType  @default(coding)
  estimatedCostLevel  CostLevel @default(medium)
  priority            Priority  @default(P3)
  titleTemplate       String
  descriptionTemplate String
  variables           Json      @default("[]")
  isBuiltIn           Boolean   @default(false)
  usageCount          Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([category])
  @@index([isBuiltIn])
}

// Global key/value configuration store.
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DailyReport {
  id                   String   @id @default(cuid())
  date                 DateTime @default(now())
  completedCount       Int      @default(0)
  failedCount          Int      @default(0)
  runningCount         Int      @default(0)
  pendingCount         Int      @default(0)
  queuedCount          Int      @default(0)
  retriedCount         Int      @default(0)
  timedOutCount        Int      @default(0)
  recoveryCount        Int      @default(0)
  avgExecutionMinutes  Float?
  activeServerCount    Int      @default(0)
  activeAgentCount     Int      @default(0)
  generatedBy          String   @default("manual")
  periodStart          DateTime?
  periodEnd            DateTime?
  reportText           String?
  topProjectId         String?
  topProjectName       String?
  createdAt            DateTime @default(now())
}

model WeeklyReport {
  id                  String   @id @default(cuid())
  weekStart           DateTime
  completedCount      Int      @default(0)
  failedCount         Int      @default(0)
  runningCount        Int      @default(0)
  pendingCount        Int      @default(0)
  queuedCount         Int      @default(0)
  retriedCount        Int      @default(0)
  timedOutCount       Int      @default(0)
  recoveryCount       Int      @default(0)
  avgExecutionMinutes Float?
  activeServerCount   Int      @default(0)
  activeAgentCount    Int      @default(0)
  agentUtilisation    Json     @default("{}")
  topCompletedTasks   Json     @default("[]")
  generatedBy         String   @default("manual")
  reportText          String?
  createdAt           DateTime @default(now())

  @@index([weekStart])
}

model MonthlyReport {
  id                  String   @id @default(cuid())
  monthStart          DateTime
  completedCount      Int      @default(0)
  failedCount         Int      @default(0)
  runningCount        Int      @default(0)
  pendingCount        Int      @default(0)
  queuedCount         Int      @default(0)
  retriedCount        Int      @default(0)
  timedOutCount       Int      @default(0)
  recoveryCount       Int      @default(0)
  avgExecutionMinutes Float?
  activeServerCount   Int      @default(0)
  activeAgentCount    Int      @default(0)
  agentUtilisation    Json     @default("{}")
  topCompletedTasks   Json     @default("[]")
  generatedBy         String   @default("manual")
  reportText          String?
  createdAt           DateTime @default(now())

  @@index([monthStart])
}

// Tracks when a usage-paused server or agent should be automatically resumed.
// One pending record per resource (unique on resourceType + resourceId).
// The poller fires triggerDueResumes() each cycle to clear stale pauses.
model ScheduledResume {
  id           String   @id @default(cuid())
  resourceType String   // "server" | "agent"
  resourceId   String
  resumeAt     DateTime // UTC time when the quota resets
  triggered    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([resourceType, resourceId])
  @@index([resumeAt, triggered])
}

model WeeklyAnalytics {
  id                    String   @id @default(cuid())
  weekStart             DateTime @unique
  weekEnd               DateTime
  tasksCompleted        Int      @default(0)
  tasksFailed           Int      @default(0)
  tasksRetried          Int      @default(0)
  tasksTimedOut         Int      @default(0)
  tasksCreated          Int      @default(0)
  reviewsRun            Int      @default(0)
  reviewsPassed         Int      @default(0)
  reviewsFailed         Int      @default(0)
  avgExecutionMinutes   Float?
  p50ExecutionMinutes   Float?
  p95ExecutionMinutes   Float?
  workerRecoveries      Int      @default(0)
  dispatchFailures      Int      @default(0)
  createdAt             DateTime @default(now())

  @@index([weekStart])
}

enum ScanStatus {
  running
  completed
  failed
}

enum SuggestionStatus {
  pending_review
  approved
  rejected
  converted
}

enum SuggestionSourceType {
  scan
  debt
  review
  manual
}

model TaskSuggestion {
  id                 String               @id @default(cuid())
  projectId          String
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceType         SuggestionSourceType @default(manual)
  sourceId           String?
  title              String
  description        String
  priority           Priority             @default(P3)
  taskType           TaskType             @default(coding)
  estimatedCostLevel CostLevel            @default(medium)
  rationale          String?
  status             SuggestionStatus     @default(pending_review)
  convertedTaskId    String?
  reviewNote         String?
  reviewedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([projectId, status])
  @@index([sourceType, sourceId])
}

model ProjectScan {
  id               String     @id @default(cuid())
  projectId        String
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scanType         String     @default("gap_analysis")
  status           ScanStatus @default(running)
  findings         Json       @default("[]")
  findingsCount    Int        @default(0)
  scannedTaskCount Int        @default(0)
  runOnServerId    String?
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  errorMessage     String?
  createdAt        DateTime   @default(now())

  @@index([projectId, createdAt])
  @@index([status])
}

enum DebtSeverity {
  low
  medium
  high
  critical
}

enum DebtCategory {
  architecture
  testing
  documentation
  security
  performance
}

enum DebtStatus {
  open
  acknowledged
  in_progress
  resolved
  wont_fix
}

model DebtItem {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  severity    DebtSeverity @default(medium)
  category    DebtCategory @default(architecture)
  status      DebtStatus   @default(open)
  evidence    Json         @default("{}")
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId, status])
  @@index([severity])
  @@index([status])
}

enum CycleStatus {
  idle
  scanning
  detecting_debt
  generating_suggestions
  awaiting_approval
  executing
  reviewing
  completed
  cancelled
  failed
}

model ImprovementCycle {
  id                   String      @id @default(cuid())
  projectId            String
  project              Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status               CycleStatus @default(idle)
  automationLevel      Int         @default(1)
  scanId               String?
  tasksCreated         Int         @default(0)
  tasksExecuted        Int         @default(0)
  tasksReviewed        Int         @default(0)
  suggestionsGenerated Int         @default(0)
  suggestionsApproved  Int         @default(0)
  cycleError           String?
  startedAt            DateTime    @default(now())
  completedAt          DateTime?
  nextCycleAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([projectId, createdAt])
  @@index([status])
}

// Immutable, append-only event log for every meaningful state change.
model AuditEvent {
  id         String   @id @default(cuid())
  entityType String   // "task" | "project" | "server" | "agent"
  entityId   String
  eventType  String   // "task.created", "task.dispatched", "task.completed", etc.
  actorType  String   @default("system") // "system" | "user" | "poller"
  payload    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([eventType, createdAt])
}

// Recurring task template. Each cycle the poller spawns a new pending Task
// when nextRunAt <= now() and enabled = true.
model ScheduledTask {
  id                 String    @id @default(cuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  cronSchedule       String    // 5-field cron expression, e.g. "0 3 * * *"
  priority           Priority  @default(P3)
  taskType           TaskType  @default(coding)
  estimatedCostLevel CostLevel @default(medium)
  timeoutMinutes     Int?
  maxRetries         Int       @default(0)
  enabled            Boolean   @default(true)
  lastRunAt          DateTime?
  nextRunAt          DateTime? // pre-computed by service; null until first compute
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  spawnedTasks       Task[]

  @@index([projectId])
  @@index([nextRunAt, enabled])
}

// Admin-panel action audit log — tracks every mutating action taken via admin UI/API.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actor      String   @default("admin") // IP address or "admin"
  action     String   // e.g. "config.updated", "archival.triggered", "suggestion.approved"
  targetType String?  // "SystemConfig" | "Server" | "Agent" | "Suggestion" | etc.
  targetId   String?  // entity ID or key name
  payload    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
}
