# Required for local dev (docker-compose provides DATABASE_URL automatically
# when you run `docker compose up` — only needed if running `npm run dev` directly
# against your own Postgres instance).
DATABASE_URL=postgresql://postgres:postgres_dev@localhost:5432/claude_task_monitor?schema=public

# Required. Without it, auth middleware warns but allows all requests through
# unauthenticated. Any non-empty string works for local dev.
AUTH_SECRET=dev-only-change-me

# Required for per-task secret encryption (64-char hex string).
# Generate one with: openssl rand -hex 32
TASK_SECRET_KEY=

# Required for the admin panel. Without it, admin endpoints return 503.
ADMIN_PASSWORD=

# Set to your dev hostname, e.g. http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
