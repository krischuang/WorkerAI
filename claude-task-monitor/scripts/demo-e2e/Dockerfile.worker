# Disposable "worker" image for the Demo Day end-to-end scenario.
#
# This is NOT a production image and is never pushed anywhere. It exists only
# so scripts/demo-e2e/run.ts has a real SSH + tmux target to dispatch to —
# standing in for a real remote worker server, without touching any
# production host or credentials. Build + run + remove it locally.
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server tmux git coreutils procps \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd /home/demo/.ssh \
    && useradd -m -s /bin/bash demo \
    && mkdir -p /home/demo/.ssh \
    && chown -R demo:demo /home/demo \
    && chmod 700 /home/demo/.ssh

# Host keys + minimal sshd config: pubkey auth only, no root login, no passwords.
RUN ssh-keygen -A \
    && sed -i \
      -e 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' \
      -e 's/^#\?PermitRootLogin.*/PermitRootLogin no/' \
      -e 's/^#\?PubkeyAuthentication.*/PubkeyAuthentication yes/' \
      /etc/ssh/sshd_config \
    && echo "AuthorizedKeysFile /home/demo/.ssh/authorized_keys" >> /etc/ssh/sshd_config

COPY fake-claude.sh /home/demo/fake-claude.sh
RUN chmod +x /home/demo/fake-claude.sh && chown demo:demo /home/demo/fake-claude.sh

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
