# Hot-reload development override.
#
# Copy this file to docker-compose.override.yml to enable live-reload in the
# 'app' container.  Docker Compose automatically merges the override with
# docker-compose.yml when both files exist in the same directory.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up --build
#
# Changes to source files on your host machine are reflected immediately inside
# the container because the repo root is mounted at /app.  node_modules is kept
# in an anonymous volume so the host copy does not shadow the container's build.

services:
  app:
    volumes:
      - .:/app
      # Keep the container's node_modules isolated from the host copy.
      - /app/node_modules
      # Mount the single host key file at the same stable path used by docker-compose.yml.
      # Set SSH_KEY_FILE in your shell or .env to override the source path.
      - ${SSH_KEY_FILE:-/home/ec2-user/.ssh/WorkerAI.pem}:/app/.ssh/WorkerAI.pem:ro
    command: ["sh", "-c", "npm run dev"]
